# GitHub Personal Access Token (for API rate limits)
GITHUB_TOKEN=your_github_token_here

# News API Key (optional - for NewsAPI.org)
NEWS_API_KEY=your_news_api_key_here

# Hugging Face Token (optional - for model downloads)
HF_TOKEN=your_huggingface_token_here

# Supabase (required - for faculty interests)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# GoToSocial (required - for posting to social.castalia.institute)
# Faculty analyses run through the Castalia Supabase Edge Function. Its Gemini key
# stays in the Supabase environment; do not add it to this file or GitHub Secrets.
# FACULTY_SUMMARY_FUNCTION=ask-faculty-voice

GOTOSOCIAL_API_TOKEN=your_gotosocial_token_here
GOTOSOCIAL_URL=https://social.castalia.institute
